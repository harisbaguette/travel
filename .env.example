# 친구와 함께 편집하려면 필요하다. 없으면 앱은 혼자 쓰기 모드로 그냥 동작한다
# (핀·일정이 내 브라우저에만 저장됨).
#
# 이 파일을 .env.local 로 복사한 뒤, Neon(https://neon.com)에서 만든 접속 주소를 넣는다.
# 접속 주소는 비밀번호가 들어 있는 비밀이다 — git에 올리지 않는다(.gitignore가 막아 둠).
DATABASE_URL=

# 비서(AI 채팅) 기능에 필요하다. 없으면 비서 화면에서 "AI 접속 정보가 없어요" 안내가 뜨고,
# 나머지 앱(지도·여행·주변 음식점 긁어오기)은 그대로 동작한다.
# console.anthropic.com 에서 키를 만들어 넣는다. Vercel 배포 시 환경 변수에도 같이 넣는다.
# 키는 비밀번호 같은 비밀이다 — git에 올리지 않는다(.gitignore가 막아 둠).
ANTHROPIC_API_KEY=
