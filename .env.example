# 친구와 함께 편집하려면 필요하다. 없으면 앱은 혼자 쓰기 모드로 그냥 동작한다
# (핀·일정이 내 브라우저에만 저장됨).
#
# 이 파일을 .env.local 로 복사한 뒤, Neon(https://neon.com)에서 만든 접속 주소를 넣는다.
# 접속 주소는 비밀번호가 들어 있는 비밀이다 — git에 올리지 않는다(.gitignore가 막아 둠).
DATABASE_URL=

# 비서(AI 채팅) 기능에 필요하다. 없으면 비서 화면에서 "AI 접속 정보가 없어요" 안내가 뜨고,
# 나머지 앱(지도·여행·주변 음식점 긁어오기)은 그대로 동작한다.
# 둘 중 하나만 넣으면 된다.
#  1) platform.deepseek.com 에서 받은 딥시크 열쇠 → DEEPSEEK_API_KEY
#  2) openrouter.ai 에서 받은 중개소 열쇠(sk-or- 로 시작) → OPENROUTER_API_KEY
# 둘 다 있으면 딥시크 열쇠를 먼저 쓴다. Vercel 배포 시 환경 변수에도 같이 넣는다.
# 키는 비밀번호 같은 비밀이다 — git에 올리지 않는다(.gitignore가 막아 둠).
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# (선택) 없어도 비서는 네이버 블로그 후기를 찾아온다 — 열쇠가 없으면 블로그 홈이 자기 화면을
# 채울 때 쓰는 공개 목록을 그대로 읽는다. 다만 그 통로는 네이버가 공식으로 연 문이 아니라
# 형식이 바뀌면 조용히 빈 결과가 될 수 있고, 국내 가게 좌표 확인도 못 쓴다.
# 열쇠를 넣으면 공식 창구로 바뀌어 더 안정적이고 좌표도 정확해진다.
# 만들기: developers.naver.com → 애플리케이션 등록 → 사용 API에서 "검색"을 고르면
#   Client ID와 Client Secret 두 개가 나온다. 그대로 아래에 넣는다.
# 이 두 개도 비밀이다 — git에 올리지 않는다.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# 공식 구글 지도 + 구글 장소 검색(Places)을 켜는 열쇠. 지도는 이 열쇠가 있어야 뜬다 —
# 없으면 지도 자리에 "지도를 불러오지 못했어요"만 나오고, 핀·일정·기록 화면은 그대로 쓸 수 있다.
# 장소 검색은 열쇠가 없어도 열쇠 없는 구글 통로로 동작하지만, 그 통로는 비공식이라
# 형식이 바뀌면 조용히 빈 결과가 될 수 있다 — 열쇠를 넣으면 공식 검색을 먼저 쓴다.
# 만들기: console.cloud.google.com → 프로젝트 생성 → 결제 카드 등록(무료 한도 넘기 전엔 청구 없음)
#   → "Maps JavaScript API"와 "Places API (New)" 사용 설정 → 사용자 인증 정보에서 API 키 발급
#   → 키 제한: HTTP 리퍼러에 배포 주소(pinjido.vercel.app)와 localhost를 등록해 도용을 막는다.
# 이 키는 화면(브라우저)에 노출되는 종류라 리퍼러 제한이 필수다. Vercel 환경 변수에도 같이 넣는다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
