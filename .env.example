# 친구와 함께 편집하려면 필요하다. 없으면 앱은 혼자 쓰기 모드로 그냥 동작한다
# (핀·일정이 내 브라우저에만 저장됨).
#
# 이 파일을 .env.local 로 복사한 뒤, Neon(https://neon.com)에서 만든 접속 주소를 넣는다.
# 접속 주소는 비밀번호가 들어 있는 비밀이다 — git에 올리지 않는다(.gitignore가 막아 둠).
DATABASE_URL=

# 비서(AI 채팅) 기능에 필요하다. 없으면 비서 화면에서 "AI 접속 정보가 없어요" 안내가 뜨고,
# 나머지 앱(지도·여행·주변 음식점 긁어오기)은 그대로 동작한다.
# console.anthropic.com 에서 키를 만들어 넣는다. Vercel 배포 시 환경 변수에도 같이 넣는다.
# 키는 비밀번호 같은 비밀이다 — git에 올리지 않는다(.gitignore가 막아 둠).
ANTHROPIC_API_KEY=

# 진짜 구글 지도 + 구글 장소 검색을 켜는 열쇠. 없으면 무료 지도(OpenFreeMap)로 동작한다.
# 만들기: console.cloud.google.com → 프로젝트 생성 → 결제 카드 등록(무료 한도 넘기 전엔 청구 없음)
#   → "Maps JavaScript API"와 "Places API (New)" 사용 설정 → 사용자 인증 정보에서 API 키 발급
#   → 키 제한: HTTP 리퍼러에 배포 주소(pinjido.vercel.app)와 localhost를 등록해 도용을 막는다.
# 이 키는 화면(브라우저)에 노출되는 종류라 리퍼러 제한이 필수다. Vercel 환경 변수에도 같이 넣는다.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
